[TEMPLATE]
### Gamaj Node environment
# Copy to <app dir>/.env and adjust. Every key is GAMAJ-owned.

GAMAJ_NODE_SERVICE_HOST = "0.0.0.0"
GAMAJ_NODE_SERVICE_PORT = 62050
GAMAJ_NODE_XRAY_API_HOST = "127.0.0.1"
GAMAJ_NODE_XRAY_API_PORT = 62051
GAMAJ_DATA_DIR = /var/lib/gamaj-node
GAMAJ_NODE_INSTALL_MODE = binary
# GAMAJ_XRAY_EXECUTABLE_PATH = /var/lib/gamaj-node/xray-core/xray
# GAMAJ_XRAY_ASSETS_PATH = /var/lib/gamaj-node/xray-core
# GAMAJ_NODE_XRAY_LOG_DIR = /var/log/gamaj-node

# OpenVPN and WireGuard run on every Gamaj Node: the node installs
# wireguard-tools/nftables, loads the kernel module, and routes each inbound to
# its Xray tunnel port with TPROXY by default. Direct NAT is opt-in with
# nat_enabled=true in the tunnel payload.
# GAMAJ_NODE_VERSION = "is.0.0.1"

# Gamaj-node maintenance service
# GAMAJ_NODE_SCRIPT_SCHEME = "http"
# GAMAJ_NODE_SCRIPT_HOST = "127.0.0.1"
# GAMAJ_NODE_SCRIPT_PORT = 3100
# GAMAJ_NODE_SCRIPT_ALLOWED_HOSTS = "127.0.0.1,::1,localhost"
# GAMAJ_NODE_SCRIPT_BIN = "/usr/local/bin/gamaj-node"

GAMAJ_NODE_SSL_CERT_FILE = /var/lib/gamaj-node/ssl_cert.pem
GAMAJ_NODE_SSL_KEY_FILE = /var/lib/gamaj-node/ssl_key.pem
GAMAJ_NODE_SSL_CLIENT_CERT_FILE = /var/lib/gamaj-node/ssl_client_cert.pem

### for developers
# GAMAJ_DEBUG = false

### Select Specific Inbounds
# GAMAJ_NODE_INBOUNDS = "VLESS TCP REALITY, VMESS TCP NO TLS"
